# Copiar a .env. Las comillas simples conservan símbolos como $ en las contraseñas.
# No incluir .env ni secrets/ en Git, paquetes públicos o imágenes.
DB_HOST='CAMBIAR_ENDPOINT_AWS'
DB_PORT=5432
DB_NAME='CAMBIAR_BASE_EXISTENTE'
DB_USERNAME='CAMBIAR_USUARIO_AWS'
DB_PASSWORD='CAMBIAR_PASSWORD_AWS'
ETL_API_KEY='CAMBIAR_CLAVE_COMPARTIDA'
PUBLIC_ORIGIN='http://CAMBIAR_IP_LINUX:5173'

# Estas rutas corresponden al paquete portátil preparado para Linux.
ETL_CONTEXT=../etl
BACKEND_CONTEXT=../backend
FRONTEND_CONTEXT=../frontend
