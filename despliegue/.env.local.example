# Copiar a .env.local en la PC de destino. Completar los valores privados allí.
# PostgreSQL permanece en AWS: no se crea otra base ni se copia la actual.
# Usar comillas simples al escribir valores que contengan $ u otros símbolos.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
ETL_API_KEY=

# URL con la que abrirás el frontend: http://IP_DE_LA_OTRA_PC:5173
PUBLIC_ORIGIN=
FRONTEND_PORT=5173
BACKEND_PORT=8080
FASTAPI_PORT=8001
SESSION_COOKIE_SECURE=false
ETL_CONCURRENCIA=20

# Rutas relativas a ETL_INFRA_TI/despliegue, según los repositorios actuales.
# Ajustarlas únicamente si se copiaron a otra estructura de carpetas.
ETL_CONTEXT=..
BACKEND_CONTEXT=../../Backend-SI-INFRA-TI/backend-infra-ti
FRONTEND_CONTEXT=../../Frontend-SI-INFRA-TI/Frontend-SI-INFRA-TI
SIMULADORES_DIR=../data

# Opcional: primer administrador, únicamente si la tabla de usuarios está vacía.
# Completar los tres valores solo en .env.local privado.
# Si la base ya tiene usuarios, no crea ni modifica cuentas o contraseñas.
ADMIN_CORREO=
ADMIN_NOMBRE=
ADMIN_CONTRASENA=
