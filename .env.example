# Valores de ejemplo. Cambiar ETL_API_KEY antes de iniciar.
ETL_API_KEY=reemplazar-por-una-clave-aleatoria
# Vacío para equipos reales; public para simuladores.
SNMP_CONTEXT_NAME=public
SNMP_TIMEOUT=3
SNMP_RETRIES=1
API_HOST=127.0.0.1
API_PORT=8001
API_DOCS=0
# Vacío no restringe; ejemplo local: 127.0.0.0/8,::1/128
SNMP_REDES_PERMITIDAS=
# Necesaria para crear activos; la prueba SNMP funciona sin PostgreSQL.
# La base debe tener aplicado schema.sql por el módulo propietario del esquema.
DATABASE_URL=postgresql://usuario:clave@127.0.0.1:5432/inventario
DB_TIMEOUT=5
