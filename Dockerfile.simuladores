# syntax=docker/dockerfile:1
FROM python:3.13-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY requirements-simuladores.txt requirements-constraints.txt ./
RUN pip install --no-cache-dir -r requirements-simuladores.txt \
    && groupadd --gid 10001 infra \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin infra
COPY --chown=10001:10001 data ./data
USER 10001:10001
HEALTHCHECK --interval=60s --timeout=20s --start-period=45s --retries=3 \
    CMD ["python", "data/servicio_agentes.py", "--verificar"]
CMD ["python", "-B", "data/servicio_agentes.py"]
